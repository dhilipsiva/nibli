/// Nibli WIT (WebAssembly Interface Types) definition.
///
/// The Nibli symbolic reasoning engine ships as ONE WASM component (world
/// `nibli-pipeline`): the KR front-end (nibli-kr) → nibli-semantics (compile) →
/// nibli-reason (reason) are internal Rust crate stages, NOT separate components. This file defines only that
/// component's host boundary:
///   - `logic-types`: First-Order Logic IR (logic buffers, proof traces, …)
///   - `error-types`: structured error variants shared across the pipeline
///   - `compute-backend`: host-provided external predicate evaluation (import)
///   - `engine`: the session API (export)
///
/// Data crossing the host↔component boundary uses flat index-based arrays
/// (`u32` indices into parallel lists) — no heap pointers cross the WASM boundary.
package nibli:engine@0.12.0;

/// Structured error types shared across all Nibli components.
interface error-types {
    /// Structured error type for the Nibli engine pipeline.
    /// Each variant identifies the pipeline stage that produced the error.
    variant nibli-error {
        /// Parse error with source location.
        syntax(syntax-detail),
        /// Semantic compilation error.
        semantic(string),
        /// Reasoning engine error (assertion/query failure).
        reasoning(string),
        /// Compute backend error. Fields: (kind, message).
        backend(tuple<string, string>),
    }

    /// Detail record for syntax (parse) errors.
    record syntax-detail {
        /// Human-readable error description.
        message: string,
        /// 1-based line number.
        line: u32,
        /// 1-based column number.
        column: u32,
    }
}

/// First-Order Logic intermediate representation types.
///
/// The semantics compiler transforms the parser's AST into this flat logic
/// buffer. The reasoning engine consumes it to assert facts or check queries
/// against the indexed fact store.
interface logic-types {
    /// A term in a logical formula: variable, constant, description reference,
    /// unspecified placeholder, or numeric literal.
    variant logical-term {
        /// A bound or free variable (e.g., Skolem variables, universally quantified vars).
        variable(string),
        /// A ground constant (e.g., entity names).
        constant(string),
        /// An opaque description reference (a definite description).
        description(string),
        /// Unspecified placeholder (the nibli KR `_`).
        unspecified,
        /// Numeric literal.
        number(f64),
    }

    /// A node in the flat logic graph. Each variant corresponds to an FOL constructor.
    /// Nodes reference children by `u32` index into the `logic-buffer.nodes` array.
    variant logic-node {
        /// Ground or quantified predicate. Fields: (relation-name, argument-terms).
        predicate(tuple<string, list<logical-term>>),
        /// A predicate dispatched to an external compute backend for evaluation.
        compute-node(tuple<string, list<logical-term>>),
        /// Conjunction: left ∧ right. Fields: (left-node-id, right-node-id).
        and-node(tuple<u32, u32>),
        /// Disjunction: left ∨ right. Fields: (left-node-id, right-node-id).
        or-node(tuple<u32, u32>),
        /// Negation: ¬inner. Payload: inner-node-id.
        not-node(u32),
        /// Existential quantifier: ∃var. body. Fields: (variable-name, body-node-id).
        exists-node(tuple<string, u32>),
        /// Universal quantifier: ∀var. body. Fields: (variable-name, body-node-id).
        for-all-node(tuple<string, u32>),
        /// Past tense wrapper. Payload: inner-node-id.
        past-node(u32),
        /// Present tense wrapper. Payload: inner-node-id.
        present-node(u32),
        /// Future tense wrapper. Payload: inner-node-id.
        future-node(u32),
        /// Deontic obligation wrapper (must). Payload: inner-node-id.
        obligatory-node(u32),
        /// Deontic permission wrapper (may). Payload: inner-node-id.
        permitted-node(u32),
        /// Exactly N entities satisfy the current body. Query-only in asserted
        /// position; it may occur as quoted opaque-abstraction content.
        /// Fields: Count(variable-name, count, body-node-id).
        count-node(tuple<string, u32, u32>),
    }

    /// Flat-buffer FOL formula: a list of logic nodes with u32 cross-references.
    record logic-buffer {
        /// All logic nodes in the formula.
        nodes: list<logic-node>,
        /// Indices of top-level (root) formula nodes.
        roots: list<u32>,
    }

    /// Where an enumerated witness came from.
    enum witness-origin {
        /// A non-generated term supplied by asserted data or a rule template.
        knowledge-base,
        /// An opaque witness minted by the reasoner for an existential.
        generated-witness,
        /// A witness minted by the optional legacy existential-import profile.
        existential-import,
    }

    /// A single variable-to-term binding from witness extraction.
    record witness-binding {
        variable: string,
        term: logical-term,
        origin: witness-origin,
    }

    /// Why the engine cannot yet return a definitive TRUE/FALSE answer.
    enum unknown-reason {
        cycle-cut,
        incomplete-knowledge,
        naf-dependent,
        backend-unavailable,
        /// A numeric operand or computed result is non-finite (±inf/NaN).
        non-finite,
    }

    /// Which execution limit prevented a definitive answer.
    enum resource-kind { depth, fuel, memory }

    /// Top-level entailment result returned by the reasoner.
    variant query-result {
        true,
        false,
        unknown(unknown-reason),
        resource-exceeded(resource-kind),
    }

    /// Unique identifier for a stored assertion in the knowledge base.
    type fact-id = u64;

    /// One active direct assertion that supports an asserted proof leaf.
    record assertion-citation {
        id: fact-id,
        label: string,
    }

    /// One stored rule assertion that supports a derived or presupposed fact.
    record rule-citation {
        assertion-id: fact-id,
        rule-ordinal: u32,
        assertion-label: string,
    }

    /// Named-field payload records for `proof-rule`'s data-carrying variants.
    /// WIT variant cases hold at most one payload type, so each carries a record
    /// whose fields mirror the canonical `nibli_types::logic::ProofRule` — the
    /// interface self-documents (named fields) instead of positional tuples.
    record disjunction-check-rule {
        /// The disjunction fact checked in the fact store.
        detail: string,
    }
    record disjunction-intro-rule {
        /// Which disjunct was proved: "left" or "right".
        side: string,
    }
    record modal-passthrough-rule {
        /// The transparent tense/deontic wrapper kind.
        kind: string,
    }
    record exists-witness-rule {
        /// The existential variable.
        var: string,
        /// The witness term that satisfied it.
        term: logical-term,
        /// Whether the witness is user/KB data, ordinarily generated, or minted by import.
        origin: witness-origin,
    }
    record forall-verified-rule {
        /// The entities verified against the universal body.
        entities: list<witness-binding>,
    }
    record forall-counterexample-rule {
        /// The entity that falsified the universal.
        entity: witness-binding,
    }
    record count-result-rule {
        expected: u32,
        actual: u32,
        /// Included matches minted by the active import profile.
        existential-imported: u32,
    }
    record predicate-check-rule {
        method: string,
        detail: string,
    }
    record compute-check-rule {
        method: string,
        detail: string,
    }
    record asserted-rule {
        /// The ground fact that was directly asserted.
        fact: string,
        /// Every active direct assertion of this exact fact, in stable order.
        sources: list<assertion-citation>,
    }
    record derived-rule {
        /// The universal rule's label.
        label: string,
        /// The conclusion fact it derived.
        fact: string,
        /// Stored rule assertions whose canonical rule identity supports this step.
        sources: list<rule-citation>,
    }
    record presupposed-rule {
        /// The universal rule's label.
        label: string,
        /// The fact minted by the optional legacy existential-import profile.
        fact: string,
        /// Rule assertion(s) that causally licensed this presupposition.
        sources: list<rule-citation>,
    }
    record proof-ref-rule {
        /// The already-proved fact referenced. The step's `children` carries
        /// exactly one index: the first-occurrence step holding the full proof.
        fact: string,
    }
    record equality-substitution-rule {
        original: string,
        equality-facts: string,
        substituted: string,
    }
    record rule-attempt-failed-rule {
        rule-label: string,
        failed-condition: string,
    }
    record predicate-not-found-rule {
        /// Display of the predicate that no fact/rule could satisfy.
        predicate: string,
    }

    /// Proof rule applied at a proof step. Data-carrying variants carry the
    /// named-field records above (mirroring `nibli_types::logic::ProofRule`).
    variant proof-rule {
        /// Both conjuncts checked. Children: [left, right].
        conjunction,
        /// Disjunction checked in fact store.
        disjunction-check(disjunction-check-rule),
        /// One disjunct checked. Children: [winner].
        disjunction-intro(disjunction-intro-rule),
        /// Inner formula failed. Children: [inner-attempt].
        negation,
        /// Transparent tense/deontic wrapper. Children: [inner].
        modal-passthrough(modal-passthrough-rule),
        /// Entity witness found. Children: [body-proof].
        exists-witness(exists-witness-rule),
        /// No witness found for existential.
        exists-failed,
        /// Empty domain, vacuously true.
        forall-vacuous,
        /// All entities verified. Children: [body-proof per entity].
        forall-verified(forall-verified-rule),
        /// Counterexample found. Children: [failed-body-proof].
        forall-counterexample(forall-counterexample-rule),
        /// Count check.
        count-result(count-result-rule),
        /// Predicate leaf checked.
        predicate-check(predicate-check-rule),
        /// Compute node checked.
        compute-check(compute-check-rule),
        /// Directly asserted fact.
        asserted(asserted-rule),
        /// Derived via a universal rule.
        /// Children: proof traces of each premise that triggered the rule.
        derived(derived-rule),
        /// Minted by the optional legacy existential-import profile.
        presupposed(presupposed-rule),
        /// Reference to an already-proved fact.
        /// Children: exactly one — the index of the step where the full proof
        /// was shown at its first occurrence (the memo-hit back-reference).
        /// Renderers differ deliberately: the verbose text renderer re-expands
        /// the referenced step, the collapsed/UI renderings drop it.
        proof-ref(proof-ref-rule),
        /// Equality substitution.
        equality-substitution(equality-substitution-rule),
        /// Rule was tried but a condition failed.
        rule-attempt-failed(rule-attempt-failed-rule),
        /// Predicate not found in KB and no rule could derive it.
        predicate-not-found(predicate-not-found-rule),
    }

    /// A single step in a proof trace.
    record proof-step {
        rule: proof-rule,
        holds: bool,
        children: list<u32>,
    }

    /// A complete proof trace (flat indexed buffer).
    record proof-trace {
        steps: list<proof-step>,
        root: u32,
        /// True if any step used negation-as-failure (a `Negation` step that
        /// holds): the TRUE verdict rests on the closed-world assumption, so it
        /// is weaker than a monotonic proof. Computed once in the engine
        /// (`ProofTrace::has_naf_dependency`) and carried across the boundary so
        /// a consumer need not recompute it from the steps.
        naf-dependent: bool,
        /// True if the verdict is a CLOSED-WORLD FALSE: not derivable from the KB
        /// (rather than a compute-decided FALSE from local arithmetic or a trusted
        /// external backend). The
        /// dual of `naf-dependent` — under open-world semantics it would be Unknown.
        cwa-false: bool,
    }

    /// Summary of an active fact in the knowledge base.
    /// Retained assertion state; this is not an immutable audit history.
    enum assertion-status { active, withdrawn }
    record assertion-record-summary {
        id: fact-id,
        label: string,
        status: assertion-status,
    }

    record fact-summary {
        /// Unique fact identifier (assigned at assertion time).
        id: fact-id,
        /// Human-readable label (the original KR source text or the
        /// ":assert rel args" form).
        label: string,
        /// Number of root formulas in this fact's logic buffer.
        root-count: u32,
    }

    /// Why a relation could NOT be saturated bottom-up, paired with its name.
    record materialization-refusal {
        /// The surface relation that stayed on the backward-chaining path.
        relation: string,
        /// One-line explanation (a flavoured fact, a `du` equivalence class, a
        /// compute condition, an unprojectable rule, a refused dependency, …).
        reason: string,
    }

    /// What a query's stratum-ordered saturation covered.
    record materialization-report {
        /// Relations whose extension is COMPLETE — every `~p(x)` over one of these
        /// is answered by set membership rather than by a proof attempt. Sorted.
        complete: list<string>,
        /// Relations that were wanted but not completed, each with its reason.
        /// Sorted by relation name.
        refused: list<materialization-refusal>,
    }
}

/// Host-provided external predicate evaluation.
///
/// The reasoning engine calls this interface when it encounters a predicate
/// registered for compute dispatch (e.g., `exponential`, `logarithm`). The
/// host connects to an external TCP backend or evaluates built-in arithmetic.
/// Replies are evidence for the current query only: executable compute atoms
/// are rejected at assertion ingress, and the guest never turns replies into KB
/// facts, registry rows, or cross-query outage-cache entries. The guest may
/// memoize an identical request only for the duration of one query so its proof
/// cannot disagree with its verdict. An error therefore remains
/// `backend-unavailable` even after an earlier query succeeded.
///
/// This import is the host's admission boundary. It carries no peer identity,
/// signature, request id, protocol/backend version, timestamp/nonce, replay or
/// revocation state, or admission receipt; the guest trusts `ok(bool)` for the
/// current check. The stock nibli-host implementation uses deliberately
/// plaintext, unauthenticated JSONL/TCP. A custom host may enforce stronger
/// policy before returning, but the current proof schema does not carry that
/// policy's metadata.
///
/// Supports single evaluation and batch evaluation (amortises WASM boundary
/// crossings and TCP round trips).
interface compute-backend {
    use logic-types.{logical-term};
    use error-types.{nibli-error};

    /// A single compute request: relation name + argument terms.
    record compute-request {
        relation: string,
        args: list<logical-term>,
    }

    /// Result of a single compute evaluation within a batch.
    variant compute-result {
        /// Evaluation succeeded with a boolean result.
        ok(bool),
        /// Evaluation failed with an error message.
        err(string),
    }

    /// Evaluate whether a computed predicate holds for fully-ground arguments.
    /// Returns true/false for the relation applied to the given argument terms.
    evaluate: func(relation: string, args: list<logical-term>) -> result<bool, nibli-error>;

    /// Evaluate a batch of compute requests in one cross-component call.
    /// Returns results in the same order as the input requests.
    /// Each result is independent — one failure does not affect others.
    evaluate-batch: func(requests: list<compute-request>) -> list<compute-result>;

}

/// High-level engine interface: the single shipping component's API.
///
/// Provides a `session` resource with text-level assert/query methods that
/// internally orchestrate the full nibli-kr → nibli-semantics → nibli-reason
/// pipeline (linked as Rust crate stages). This is the primary API for end users
/// (e.g., the REPL nibli-host; the in-browser surfaces nibli-ui/nibli-wasm embed
/// the same crates natively rather than through this component).
interface engine {
    use logic-types.{fact-id, fact-summary, assertion-record-summary, logic-buffer, logical-term, materialization-report, proof-trace, query-result, witness-binding};
    use error-types.{nibli-error};

    /// A user-facing session that wraps the full pipeline.
    /// Internally creates a nibli-kr → nibli-semantics → nibli-reason chain with a fresh KB.
    resource session {
        /// Create a new session (internally creates a fresh KB).
        constructor();
        /// Assert KR text as facts. A multi-statement input splits into one
        /// INDEPENDENT fact per root (logical connectives compile to a
        /// single root and stay one compound fact — same granularity as the
        /// native surfaces). Returns one (fact-id, logic-buffer) pair per
        /// asserted root, in root order: the id for later retraction, the
        /// root's compiled buffer so a persisting host can store the FACT
        /// itself (recompile-free replay via `assert-buffer-with-id`).
        /// A count-node or executable compute-node in asserted position
        /// (outside opaque quoted content) is rejected before a fact id is
        /// allocated — as are the reference external compute names even when
        /// unregistered; this API does not install cardinality constraints or
        /// computed premises.
        assert-text: func(input: string) -> result<list<tuple<fact-id, logic-buffer>>, nibli-error>;
        /// Query whether corpus-resolvable KR text is entailed. Compute
        /// registration changes routing after compilation; it does not make an
        /// unknown text name compile or provide an arity.
        query-text: func(input: string) -> result<query-result, nibli-error>;
        /// Query KR text with proof trace.
        query-text-with-proof: func(input: string) -> result<tuple<query-result, proof-trace>, nibli-error>;
        /// Query KR text and return witness bindings for existential
        /// variables. A successful list is complete; if any evaluated candidate
        /// leaf is non-definitive, returns nibli-error instead of partial rows.
        query-find-text: func(input: string) -> result<list<list<witness-binding>>, nibli-error>;
        /// Debug: compile corpus-resolvable text to the typed logic buffer
        /// without asserting or checking assertion admission. Unknown names and
        /// wrong corpus arities still fail at this compile-only boundary.
        /// The host renders it (structural tree + English gloss); no S-expression
        /// string crosses the boundary.
        compile-debug: func(input: string) -> result<logic-buffer, nibli-error>;
        /// Reset the session's KB to fresh state.
        reset-kb: func() -> result<_, nibli-error>;
        /// Route a committed-corpus predicate to external computation dispatch.
        /// Registration is post-compile routing metadata: it does not declare
        /// KR vocabulary or infer arity, and an unknown name is refused. Corpus
        /// surface aliases and committed compounds normalize to the canonical
        /// relation emitted in logic IR; the registry and backend see that name.
        /// Arbitrary compute names require caller-built raw compute-node IR or a
        /// future explicit vocabulary/schema extension. This component exports
        /// no raw-buffer query method, so its current text query methods can
        /// dispatch only corpus-resolvable relations.
        /// Refused (`reasoning` error) while any LIVE stored fact or rule
        /// references `name` (role spellings collapse onto their anchor on
        /// both sides of the scan); the message names the blocking fact ids —
        /// retract them first, then re-register. Role-shaped names
        /// (`eats_x1` — register the anchor) and the engine-special relations
        /// (identity, the numeric comparisons) are refused outright. The
        /// reference external names (`exponential`, `logarithm`) are
        /// additionally query-only at assertion ingress whether or not they
        /// are registered, so registration order can never strand a stored
        /// fact.
        register-compute-predicate: func(name: string) -> result<_, nibli-error>;
        /// The session's canonical compiled compute-relation names, sorted (the
        /// built-in arithmetic names are pre-registered and included). Backs
        /// the bare `:compute` report.
        compute-predicates: func() -> list<string>;
        /// Assert a ground fact directly into the KB (bypasses text parsing).
        /// A relation already registered for compute is marked and rejected as
        /// query-only rather than stored as an ordinary shadow fact; the
        /// reference external compute names are rejected the same way even
        /// when unregistered.
        assert-fact: func(relation: string, args: list<logical-term>) -> result<fact-id, nibli-error>;
        /// Assert a ground fact directly with a CALLER-CHOSEN fact id (for
        /// persistent restart-replay; see `assert-buffer-with-id`).
        assert-fact-with-id: func(relation: string, args: list<logical-term>, id: fact-id) -> result<_, nibli-error>;
        /// Assert an already-compiled logic buffer under a CALLER-CHOSEN fact
        /// id — the recompile-free replay primitive for hosts that persist the
        /// per-root buffers `assert-text` returns. `label` is the fact's
        /// display label (the original source text). A count-node or executable
        /// compute-node in asserted position fails closed, including during
        /// legacy-row replay; quoted opaque-abstraction content remains inert.
        /// The buffer is re-marked against the session's LIVE compute registry
        /// first, so replaying a row out of order relative to a registration
        /// fails closed instead of storing a plain fact for a registered name.
        assert-buffer-with-id: func(buffer: logic-buffer, label: string, id: fact-id) -> result<_, nibli-error>;
        /// Retract a previously asserted fact by its ID.
        retract-fact: func(id: fact-id) -> result<_, nibli-error>;
        /// List all active (non-retracted) facts.
        list-facts: func() -> result<list<fact-summary>, nibli-error>;
        /// All retained assertion identities in ascending order, active or withdrawn.
        list-assertion-records: func() -> result<list<assertion-record-summary>, nibli-error>;
        /// Trusted persistence replay: reserve a withdrawn identity without decoding its payload.
        restore-withdrawn-assertion: func(id: fact-id, label: string) -> result<_, nibli-error>;
        /// Positive reasoning depth budget (default 10). Zero is rejected.
        set-max-chain-depth: func(depth: u32) -> result<_, nibli-error>;
        max-chain-depth: func() -> u32;
        /// Enable/disable STRICT MODE (default off — permissive
        /// warn-and-insert): when on, arity mismatches and integrity-constraint
        /// violations REJECT the offending fact and fail the assertion.
        set-strict: func(strict: bool);
        /// Enable/disable legacy EXISTENTIAL-IMPORT MODE (default OFF): when on,
        /// a description universal (`animal(every dog).`) mints witnesses that
        /// participate in ∃, ∀, find, and count alike. Rebuilds the active KB.
        set-existential-import: func(enabled: bool) -> result<_, nibli-error>;
        /// Whether legacy existential import is active for this session.
        existential-import-enabled: func() -> bool;
        /// Enable/disable QUERY-CONE-SCOPED STRATUM-ORDERED MATERIALISATION
        /// (default ON): when on, query-reachable cones that need NAF completeness
        /// are saturated bottom-up in stratum order, so each negation-as-failure
        /// check is a set-membership test instead of an exhaustive proof attempt.
        /// Purely positive entailment stays lazy unless exact reasoning remains
        /// non-definitive; find/count request complete positive cones. Off sends
        /// every NAF back through backward chaining. A definitive TRUE/FALSE can
        /// never flip (the materialize_diff gate enforces it); a non-definitive
        /// OFF verdict may become definitive under ON — the deliberate
        /// depth-bound completeness gain.
        set-materialization: func(enabled: bool);
        /// What cumulative requested query cones have covered since the last
        /// knowledge-base mutation: completed relations and, for each relation NOT
        /// completed, a one-line reason. May remain empty after a query whose exact
        /// positive proof needed no saturation.
        ///
        /// This exists because the optimisation is invisible when it fails: a
        /// knowledge base whose `~p(x)` is still slow, or whose find/count refuses
        /// rather than undercounting, has no other way to learn WHICH relation fell
        /// out of the materialisable fragment or why.
        materialization-report: func() -> result<materialization-report, nibli-error>;
    }
}

/// Built-in authorization surface (logical auth v0.1).
///
/// Rides package `nibli:engine@0.12.0` for shipping tooling simplicity (single
/// WIT package / world). A future split to `nibli:auth@0.1.0` may re-home this
/// interface without changing method shapes. Wraps the same policy as the
/// native `nibli-auth` crate (`authorized` KR head, not corpus `can`).
interface authorizer {
    /// Hot-path decision: `allowed` is true only when entailment is TRUE.
    record decision {
        allowed: bool,
        /// Engine status label: "TRUE" | "FALSE" | "UNKNOWN" | "RESOURCE_EXCEEDED"
        verdict: string,
        reason: option<string>,
        /// Populated by allowed-fields; empty on bare can.
        fields: list<string>,
    }

    record explained {
        decision: decision,
        proof-json: option<string>,
    }

    /// Long-lived authorizer: load policy once; ephemeral context-kr per call.
    resource session {
        constructor();
        /// Load builtin policy (+ optional extra KR). Returns policy-version.
        load-policy: func(extra-kr: option<string>) -> result<string, string>;
        /// Durable KR facts (not auto-retracted). Returns fact ids.
        assert-facts: func(kr: string) -> result<list<u64>, string>;
        retract: func(id: u64) -> result<_, string>;
        /// Hot path — no proof.
        /// (`object` = protected resource id; WIT reserves the keyword `resource`.)
        can: func(agent: string, action: string, object: string,
                  context-kr: string) -> result<decision, string>;
        /// Batch authorization query returning candidate allowed booleans.
        can-any: func(agent: string, action: string, objects: list<string>,
                      context-kr: string) -> result<list<tuple<string, bool>>, string>;
        /// Field mask candidates (v0.1: all candidates if row can allows).
        allowed-fields: func(agent: string, action: string, object: string,
                             context-kr: string,
                             candidates: list<string>) -> result<list<string>, string>;
        /// Opt-in proof JSON.
        explain: func(agent: string, action: string, object: string,
                      context-kr: string) -> result<explained, string>;
        policy-version: func() -> string;
        clear-ephemeral: func() -> result<_, string>;
    }
}

/// The single Nibli WASM component: nibli-kr/nibli-semantics/nibli-reason are
/// internal Rust crate deps. Imports compute-backend (host-provided), exports the
/// engine session API and the authorizer API.
world nibli-pipeline {
    import compute-backend;
    export engine;
    export authorizer;
}
