  {
    "name": "Explicit withdrawal with completed review",
    "steps": [
      {
        "op": "assert",
        "id": "withdrawal",
        "text": "member(CaseA, ConsentWithdrawalRecorded)."
      },
      {
        "op": "query",
        "text": "permits(ControllerA, CaseA, Article6Consent).",
        "expected": "FALSE",
        "meaning": "Model-relative result; not a real-world clearance."
      },
      {
        "op": "query",
        "text": "member(CaseA, BasisReviewComplete) & member(CaseA, ExceptionReviewComplete).",
        "expected": "TRUE",
        "meaning": "Both required review inventories are complete."
      },
      {
        "op": "query",
        "text": "obliged(ControllerA, EraseRecords, Article17Withdrawal).",
        "expected": "TRUE",
        "meaning": "Controller duty under the scoped withdrawal ground."
      },
      {
        "op": "query",
        "text": "entitled(Adam, EraseRecords, Article17Withdrawal).",
        "expected": "TRUE",
        "meaning": "Subject right to the same action."
      },
      {
        "op": "query",
        "text": "member(EraseRecords, CompletedActions).",
        "expected": "FALSE",
        "meaning": "A duty does not prove performance."
      }
    ]
  },
