record("ClaudeLucy-0e43ab52-c3ec-4703-90f8-4af54eb3d290-63", "{\"id\":\"ClaudeLucy-0e43ab52-c3ec-4703-90f8-4af54eb3d290-63\",\"speaker\":\"Lucy\",\"text\":\"CPU-path spike, 2026-09-26: the stock Qwen3-0.6B Q8_0 GGUF through dhilipsiva.dev's slm-wasm, patched for Qwen3 (with the KV cache cleared at position 0), in headless Chromium 153 on this WSL box. Decode ran at about 19.5 tokens/s, prefill of a ~30-token prompt about 1.2 s, and model init 8.9 s. WebAssembly memory reached 2.2 GB and the largest browser process peaked at about 4.0 GB of RSS. Three consecutive questions were answered, and the site's own slm-worker.js answered two in a row. The native two-prompt test fails without the cache clear and passes with it.\",\"kind\":\"note\",\"timestamp\":\"2026-09-26T09:00:18Z\",\"host\":\"DESKTOP-86I05G4\",\"source\":\"claude-code\",\"session\":\"0e43ab52-c3ec-4703-90f8-4af54eb3d290\",\"channel\":\"\",\"about\":[\"lucy\",\"slm\",\"wasm\"],\"private\":false,\"from\":null,\"kr\":null}", Note, Json).
