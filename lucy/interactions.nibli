source("journal.md", "LegacyPublic1").
record("LegacyPublic2", "{\"id\":\"LegacyPublic2\",\"speaker\":\"Unknown\",\"text\":\"12:00 UTC: [about: lucy] [reported: dhilipsiva] I am not sentient and I do not verify my data; people audit and edit my memory freely. Nothing is signed or encrypted. Private memories live in private.md and private.nibli, which are not committed.\",\"kind\":\"legacy-journal\",\"timestamp\":\"2026-09-15T12:00:00Z\",\"host\":\"wsl\",\"source\":\"journal.md\",\"session\":\"\",\"channel\":\"\",\"about\":[\"lucy\"],\"private\":false,\"from\":null,\"kr\":null}", LegacyJournal, Json).
