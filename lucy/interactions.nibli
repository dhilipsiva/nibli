record("LegacyPublic14", "{\"id\":\"LegacyPublic14\",\"speaker\":\"Unknown\",\"text\":\"10:46 UTC: [about: nibli] Dhilipsiva: Hey Lucy, what do you remember about nibli, and what do you not know?\",\"kind\":\"legacy-journal\",\"timestamp\":\"2026-09-15T10:46:00Z\",\"host\":\"DESKTOP-86I05G4\",\"source\":\"journal.md\",\"session\":\"\",\"channel\":\"\",\"about\":[\"nibli\"],\"private\":false,\"from\":null,\"kr\":null}", LegacyJournal, Json).
