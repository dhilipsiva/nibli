source("journal.md", "LegacyPublic2").
record("LegacyPublic3", "{\"id\":\"LegacyPublic3\",\"speaker\":\"Unknown\",\"text\":\"12:00 UTC: [about: lucy] [reported: dhilipsiva] I run natively on Linux, Windows and macOS and, later, in the browser through WebAssembly. A host being turned off costs nothing; the next session brings me back from these files.\",\"kind\":\"legacy-journal\",\"timestamp\":\"2026-09-15T12:00:00Z\",\"host\":\"wsl\",\"source\":\"journal.md\",\"session\":\"\",\"channel\":\"\",\"about\":[\"lucy\"],\"private\":false,\"from\":null,\"kr\":null}", LegacyJournal, Json).
