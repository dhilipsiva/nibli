# Patient-and-episode scoped interaction-review teaching model
# Generated from examples/case-studies/drug/manifest.json; preserve source IDs.
# Review classifications are explicit inputs, not findings invented by the reasoner.
# Missing review evidence is incomplete workflow evidence, not a real-world negative.
# Never interpret FALSE as a safe-combination finding.
# Historical defective proxies are isolated in examples/case-studies/legacy/drug-proxy.nibli.

# id: guard-1
# Admitted evidence relation record.
admits("record").

# id: guard-2
# Admitted evidence relation part.
admits("part").

# id: guard-3
# Admitted evidence relation member.
admits("member").

# id: guard-4
# The fit relation is derived, never accepted as an ordinary evidence fact.
derived_only("fit").

# id: guard-5
# The obliged relation is derived, never accepted as an ordinary evidence fact.
derived_only("obliged").

# id: mechanism-join
# The assessment fits the shared-enzyme criterion; this is a mechanism match, not a concentration measurement.
all $a, $ep, $pair, $s, $i, $e, $ir, $sr: record($a, $ep, $pair, AssessmentRegister) & record($pair, $s, $i, InteractionPairs) & record($ir, $i, $e, MechanismRegister) & member($ir, InhibitionEdges) & record($sr, $s, $e, MechanismRegister) & member($sr, SubstrateEdges) -> fit($a, SharedMechanism, ScreeningPolicy).

# id: exposure-join
# Both relevant exposures must match the same patient and episode; a prescription-stop record does not remove residual exposure.
all $a, $ep, $pair, $p, $s, $i, $xi, $xs: record($a, $ep, $pair, AssessmentRegister) & record($ep, $p, MedicationReview, EpisodeRegister) & record($pair, $s, $i, InteractionPairs) & record($xi, $i, $p, ExposureRegister) & part($xi, $ep) & member($xi, RelevantExposures) & record($xs, $s, $p, ExposureRegister) & part($xs, $ep) & member($xs, RelevantExposures) -> fit($a, ConcurrentExposure, ScreeningPolicy).

# id: review-duty
# The fictional screening policy requires a review; it does not diagnose toxicity or prescribe treatment.
all $a, $action: fit($a, SharedMechanism, ScreeningPolicy) & fit($a, ConcurrentExposure, ScreeningPolicy) & part($action, $a) & member($action, InteractionReviewActions) -> obliged(ReviewTeam, $action, ScreeningPolicy).

# id: priority-review
# A reviewed narrow-index classification prioritizes this review; missing classification never establishes safety.
all $a, $ep, $pair, $s, $i, $action: record($a, $ep, $pair, AssessmentRegister) & record($pair, $s, $i, InteractionPairs) & member($s, NarrowTherapeuticIndexDrugs) & fit($a, SharedMechanism, ScreeningPolicy) & fit($a, ConcurrentExposure, ScreeningPolicy) & part($action, $a) & member($action, PriorityReviewActions) -> obliged(ReviewTeam, $action, PriorityScreeningPolicy).

# id: episode-a
# Fictional reviewed episode for Adam; a second episode is a different record.
record(EpisodeA, Adam, MedicationReview, EpisodeRegister).

# id: Warfarin-pair
# Candidate pair; enumeration is deliberate, not a complete interaction catalog.
record(PairWarfarin, Warfarin, Fluconazole, InteractionPairs).

# id: Warfarin-assessment
# This pair is assessed in the named episode.
record(AssessWarfarin, EpisodeA, PairWarfarin, AssessmentRegister).

# id: Warfarin-action
# Named review action belongs to this assessment.
part(ReviewWarfarin, AssessWarfarin).

# id: Warfarin-action-kind
# Ordinary interaction-review action.
member(ReviewWarfarin, InteractionReviewActions).

# id: Warfarin-priority
# Named priority review action belongs to this assessment.
part(PriorityWarfarin, AssessWarfarin).

# id: Warfarin-priority-kind
# Priority review is distinct from measured risk.
member(PriorityWarfarin, PriorityReviewActions).

# id: Apixaban-pair
# Candidate pair; enumeration is deliberate, not a complete interaction catalog.
record(PairApixaban, Apixaban, Fluconazole, InteractionPairs).

# id: Apixaban-assessment
# This pair is assessed in the named episode.
record(AssessApixaban, EpisodeA, PairApixaban, AssessmentRegister).

# id: Apixaban-action
# Named review action belongs to this assessment.
part(ReviewApixaban, AssessApixaban).

# id: Apixaban-action-kind
# Ordinary interaction-review action.
member(ReviewApixaban, InteractionReviewActions).

# id: Apixaban-priority
# Named priority review action belongs to this assessment.
part(PriorityApixaban, AssessApixaban).

# id: Apixaban-priority-kind
# Priority review is distinct from measured risk.
member(PriorityApixaban, PriorityReviewActions).

# id: Phenytoin-pair
# Candidate pair; enumeration is deliberate, not a complete interaction catalog.
record(PairPhenytoin, Phenytoin, Fluconazole, InteractionPairs).

# id: Phenytoin-assessment
# This pair is assessed in the named episode.
record(AssessPhenytoin, EpisodeA, PairPhenytoin, AssessmentRegister).

# id: Phenytoin-action
# Named review action belongs to this assessment.
part(ReviewPhenytoin, AssessPhenytoin).

# id: Phenytoin-action-kind
# Ordinary interaction-review action.
member(ReviewPhenytoin, InteractionReviewActions).

# id: Phenytoin-priority
# Named priority review action belongs to this assessment.
part(PriorityPhenytoin, AssessPhenytoin).

# id: Phenytoin-priority-kind
# Priority review is distinct from measured risk.
member(PriorityPhenytoin, PriorityReviewActions).

# id: inhibit-2c9
# Selected fluconazole inhibition pathway; classification does not quantify exposure.
record(Inhibit2C9, Fluconazole, CYP2C9, MechanismRegister).

# id: inhibit-2c9-kind
# Selected fluconazole inhibition pathway; classification does not quantify exposure.
member(Inhibit2C9, InhibitionEdges).

# id: inhibit-3a4
# Selected fluconazole inhibition pathway; classification does not quantify exposure.
record(Inhibit3A4, Fluconazole, CYP3A4, MechanismRegister).

# id: inhibit-3a4-kind
# Selected fluconazole inhibition pathway; classification does not quantify exposure.
member(Inhibit3A4, InhibitionEdges).

# id: substrate-warfarin
# Selected S-warfarin CYP2C9 pathway; other enantiomer/pathways are not exhausted.
record(SubstrateWarfarin, Warfarin, CYP2C9, MechanismRegister).

# id: substrate-warfarin-kind
# Selected S-warfarin CYP2C9 pathway; other enantiomer/pathways are not exhausted.
member(SubstrateWarfarin, SubstrateEdges).

# id: substrate-phenytoin
# Selected phenytoin CYP2C9 substrate pathway; other pathways are not exhausted.
record(SubstratePhenytoin, Phenytoin, CYP2C9, MechanismRegister).

# id: substrate-phenytoin-kind
# Selected phenytoin CYP2C9 substrate pathway; other pathways are not exhausted.
member(SubstratePhenytoin, SubstrateEdges).

# id: substrate-apixaban
# Selected apixaban CYP3A4 substrate pathway; other pathways are not exhausted.
record(SubstrateApixaban, Apixaban, CYP3A4, MechanismRegister).

# id: substrate-apixaban-kind
# Selected apixaban CYP3A4 substrate pathway; other pathways are not exhausted.
member(SubstrateApixaban, SubstrateEdges).

# id: nti-Warfarin
# NITYR prescribing information names warfarin and phenytoin as CYP2C9 substrates with a narrow therapeutic index; used only for review priority.
member(Warfarin, NarrowTherapeuticIndexDrugs).

# id: nti-Phenytoin
# NITYR prescribing information names warfarin and phenytoin as CYP2C9 substrates with a narrow therapeutic index; used only for review priority.
member(Phenytoin, NarrowTherapeuticIndexDrugs).

# id: exposure-Warfarin
# Fictional evidence of relevant exposure, distinct from a prescription or administration event.
record(ExposureWarfarin, Warfarin, Adam, ExposureRegister).

# id: episode-Warfarin
# Exposure evidence is scoped to EpisodeA.
part(ExposureWarfarin, EpisodeA).

# id: relevant-Warfarin
# Reviewer accepted this exposure as relevant in this episode.
member(ExposureWarfarin, RelevantExposures).

# id: exposure-Fluconazole
# Fictional evidence of relevant exposure, distinct from a prescription or administration event.
record(ExposureFluconazole, Fluconazole, Adam, ExposureRegister).

# id: episode-Fluconazole
# Exposure evidence is scoped to EpisodeA.
part(ExposureFluconazole, EpisodeA).

# id: relevant-Fluconazole
# Reviewer accepted this exposure as relevant in this episode.
member(ExposureFluconazole, RelevantExposures).
