{
  "manifest_version": 3,
  "name": "Ask Lucy",
  "version": "1.0.0",
  "description": "Explicit page/selection handoff and shared memory context preparation.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lucy@nibli.dev",
      "strict_min_version": "109.0"
    }
  },
  "key": ""
}
