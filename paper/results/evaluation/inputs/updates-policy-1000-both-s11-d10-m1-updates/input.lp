prevents("Sanitizer","F1").
authorized(F,"Release",S) :- carries(F,D,S,O,R), dangerous(S,D,"Exploit"), prevents("Sanitizer",F).
authorized(F,"Release",S) :- carries(F,D,S,O,R), dangerous(S,D,"Exploit"), permits("Review",F,"Waiver").
warns("Gate",F,S) :- carries(F,D,S,O,R), not authorized(F,"Release",S).
answer(0) :- authorized("F0","Release","S0").
answer(1) :- warns("Gate","F0","S0").
answer(2) :- authorized("F1","Release","S1").
answer(3) :- warns("Gate","F1","S1").
#show answer/1.
